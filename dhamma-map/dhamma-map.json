 "segments": [
  {
   "id": "s000",
   "segment_id": "sn56.11:2.4",
   "sutta_id": "sn56.11",
   "pali": "Ete kho … majjhimā paṭipadā … nibbānāya saṁvattati",
   "th": "มัชฌิมาปฏิปทาเป็นไปเพื่อนิพพาน",
   "term": "majjhimā paṭipadā"
  },
  {
   "id": "s001",
   "segment_id": "sn56.11:3.3",
   "sutta_id": "sn56.11",
   "pali": "sammādiṭṭhi sammāsaṅkappo … sammāsamādhi",
   "th": "มรรคมีองค์ 8 (รายชื่อ 8 องค์)",
   "term": "aṭṭhaṅgika magga"
  },
  {
   "id": "s002",
   "segment_id": "sn56.11:4.1",
   "sutta_id": "sn56.11",
   "pali": "Idaṁ kho pana, bhikkhave, dukkhaṁ ariyasaccaṁ—",
   "th": "ทุกขอริยสัจ (สัจจะที่ 1)",
   "term": "ariyasacca"
  },
  {
   "id": "s003",
   "segment_id": "sn56.11:4.2",
   "sutta_id": "sn56.11",
   "pali": "jātipi dukkhā … saṅkhittena pañcupādānakkhandhā dukkhā",
   "th": "ทุกข์ = ชาติ…โดยย่อคืออุปาทานขันธ์ 5",
   "term": "khandha"
  },
  {
   "id": "s004",
   "segment_id": "sn56.11:4.4",
   "sutta_id": "sn56.11",
   "pali": "yāyaṁ taṇhā ponobbhavikā nandirāgasahagatā …",
   "th": "สมุทัย = ตัณหา",
   "term": "taṇhā"
  },
  {
   "id": "s005",
   "segment_id": "sn56.11:4.5",
   "sutta_id": "sn56.11",
   "pali": "kāmataṇhā, bhavataṇhā, vibhavataṇhā",
   "th": "ตัณหา 3: กาม/ภว/วิภว",
   "term": "taṇhā"
  },
  {
   "id": "s006",
   "segment_id": "sn56.11:4.7",
   "sutta_id": "sn56.11",
   "pali": "asesavirāganirodho cāgo paṭinissaggo mutti anālayo",
   "th": "นิโรธ = ความดับตัณหาไม่มีเหลือ",
   "term": "nibbāna"
  },
  {
   "id": "s007",
   "segment_id": "sn56.11:4.9",
   "sutta_id": "sn56.11",
   "pali": "ayameva ariyo aṭṭhaṅgiko maggo …",
   "th": "มรรค = อริยอัฏฐังคิกมรรค",
   "term": "aṭṭhaṅgika magga"
  },
  {
   "id": "s008",
   "segment_id": "sn56.11:9.1",
   "sutta_id": "sn56.11",
   "pali": "tiparivaṭṭaṁ dvādasākāraṁ … ñāṇadassanaṁ",
   "th": "ติปริวัฏฏ์ ทวาทสาการ (วิธี 3 รอบ 12 อาการ)",
   "term": "tiparivaṭṭa"
  },
  {
   "id": "s009",
   "segment_id": "sn56.11:11.2",
   "sutta_id": "sn56.11",
   "pali": "yaṁ kiñci samudayadhammaṁ sabbaṁ taṁ nirodhadhamman”ti",
   "th": "ธรรมตา: สิ่งใดเกิด สิ่งนั้นดับ (ธัมมจักษุ)",
   "term": "dhammacakka"
  },
  {
   "id": "s010",
   "segment_id": "sn45.8:3.2",
   "sutta_id": "sn45.8",
   "pali": "dukkhe ñāṇaṁ, dukkhasamudaye ñāṇaṁ … paṭipadāya ñāṇaṁ",
   "th": "สัมมาทิฏฐิ = ญาณในอริยสัจ 4",
   "term": "sammādiṭṭhi"
  },
  {
   "id": "s011",
   "segment_id": "sn45.8:9.2",
   "sutta_id": "sn45.8",
   "pali": "kāye kāyānupassī … dhammesu dhammānupassī viharati",
   "th": "สัมมาสติ = สติปัฏฐาน 4",
   "term": "satipaṭṭhāna"
  },
  {
   "id": "s012",
   "segment_id": "sn45.8:10.2",
   "sutta_id": "sn45.8",
   "pali": "vivicceva kāmehi … paṭhamaṁ jhānaṁ upasampajja",
   "th": "สัมมาสมาธิ = ฌาน 1",
   "term": "jhāna"
  },
  {
   "id": "s013",
   "segment_id": "mn44:11.3",
   "sutta_id": "mn44",
   "pali": "sammāvācā … sammāājīvo ime dhammā sīlakkhandhe saṅgahitā",
   "th": "วาจา/กัมมันตะ/อาชีวะ = ศีล",
   "term": "sīla"
  },
  {
   "id": "s014",
   "segment_id": "mn44:11.4",
   "sutta_id": "mn44",
   "pali": "sammāvāyāmo … sammāsamādhi ime dhammā samādhikkhandhe saṅgahitā",
   "th": "วายามะ/สติ/สมาธิ = สมาธิ",
   "term": "samādhi"
  },
  {
   "id": "s015",
   "segment_id": "mn44:11.5",
   "sutta_id": "mn44",
   "pali": "sammādiṭṭhi … sammāsaṅkappo ime dhammā paññākkhandhe saṅgahitā",
   "th": "ทิฏฐิ/สังกัปปะ = ปัญญา",
   "term": "paññā"
  },
  {
   "id": "s016",
   "segment_id": "mn44:12.3",
   "sutta_id": "mn44",
   "pali": "cattāro satipaṭṭhānā samādhinimittā",
   "th": "สติปัฏฐาน 4 = นิมิตต์ของสมาธิ",
   "term": "satipaṭṭhāna"
  },
  {
   "id": "s017",
   "segment_id": "mn44:29.12",
   "sutta_id": "mn44",
   "pali": "Vimuttiyā kho … nibbānaṁ paṭibhāgo",
   "th": "วิมุตติมีนิพพานเป็นที่ไป",
   "term": "nibbāna"
  },
  {
   "id": "s018",
   "segment_id": "an3.89:1.3",
   "sutta_id": "an3.89",
   "pali": "Adhisīlasikkhā, adhicittasikkhā, adhipaññāsikkhā",
   "th": "ไตรสิกขา 3",
   "term": "tisso sikkhā"
  },
  {
   "id": "s019",
   "segment_id": "an3.89:4.2",
   "sutta_id": "an3.89",
   "pali": "‘idaṁ dukkhan’ti yathābhūtaṁ pajānāti …",
   "th": "อธิปัญญาสิกขา = รู้แจ้งอริยสัจ 4",
   "term": "ariyasacca"
  },
  {
   "id": "s020",
   "segment_id": "dn16:3.50.5",
   "sutta_id": "dn16",
   "pali": "cattāro satipaṭṭhānā … ariyo aṭṭhaṅgiko maggo",
   "th": "โพธิปักขิยธรรม 37 (รายชื่อ 7 หมวด)",
   "term": "bodhipakkhiya"
  },
  {
   "id": "s021",
   "segment_id": "dn16:4.8.13",
   "sutta_id": "dn16",
   "pali": "Idaṁ, bhikkhave, paṭhamaṁ mahāpadesaṁ dhāreyyātha",
   "th": "มหาปเทสที่ 1 (เกณฑ์วินิจฉัยพุทธวจนะ)",
   "term": "mahāpadesa"
  },
  {
   "id": "s022",
   "segment_id": "dn16:4.10.2",
   "sutta_id": "dn16",
   "pali": "dhammadharā vinayadharā mātikādharā",
   "th": "ผู้ทรงธรรม/วินัย/มาติกา",
   "term": "mātikā"
  },
  {
   "id": "s023",
   "segment_id": "mn117:3.2",
   "sutta_id": "mn117",
   "pali": "sammādiṭṭhi … sammāsati",
   "th": "องค์ 7 ของสัมมาสมาธิ",
   "term": "aṭṭhaṅgika magga"
  },
  {
   "id": "s024",
   "segment_id": "mn117:6.4",
   "sutta_id": "mn117",
   "pali": "sammādiṭṭhi ariyā anāsavā lokuttarā maggaṅgā",
   "th": "สัมมาทิฏฐิ 2 ระดับ (โลกุตตระ)",
   "term": "lokuttara"
  },
  {
   "id": "s025",
   "segment_id": "mn117:34.4",
   "sutta_id": "mn117",
   "pali": "aṭṭhaṅgasamannāgato sekkho, dasaṅgasamannāgato arahā",
   "th": "มรรค 8 = เสขะ, 10 = อรหันต์",
   "term": "aṭṭhaṅgika magga"
  },
  {
   "id": "s026",
   "segment_id": "mn118:15.2",
   "sutta_id": "mn118",
   "pali": "Ānāpānassati … cattāro satipaṭṭhāne paripūreti",
   "th": "อานาปานสติ → สติปัฏฐาน 4",
   "term": "ānāpāna"
  },
  {
   "id": "s027",
   "segment_id": "mn118:15.3",
   "sutta_id": "mn118",
   "pali": "Cattāro satipaṭṭhānā … satta bojjhaṅge paripūrenti",
   "th": "สติปัฏฐาน → โพชฌงค์ 7",
   "term": "bojjhaṅga"
  },
  {
   "id": "s028",
   "segment_id": "mn118:15.4",
   "sutta_id": "mn118",
   "pali": "Satta bojjhaṅgā … vijjāvimuttiṁ paripūrenti",
   "th": "โพชฌงค์ → วิชชาวิมุตติ",
   "term": "bojjhaṅga"
  },
  {
   "id": "s029",
   "segment_id": "dn22:1.7",
   "sutta_id": "dn22",
   "pali": "Ekāyano ayaṁ … yadidaṁ cattāro satipaṭṭhānā",
   "th": "เอกายนมรรค = สติปัฏฐาน 4",
   "term": "satipaṭṭhāna"
  },
  {
   "id": "s030",
   "segment_id": "dn22:13.12",
   "sutta_id": "dn22",
   "pali": "dhammesu dhammānupassī viharati pañcasu nīvaraṇesu",
   "th": "ธัมมานุปัสสนาในนิวรณ์ 5",
   "term": "nīvaraṇa"
  },
  {
   "id": "s031",
   "segment_id": "dn22:14.1",
   "sutta_id": "dn22",
   "pali": "dhammesu dhammānupassī viharati pañcasu upādānakkhandhesu",
   "th": "ธัมมานุปัสสนาในอุปาทานขันธ์ 5",
   "term": "khandha"
  },
  {
   "id": "s032",
   "segment_id": "dn22:15.1",
   "sutta_id": "dn22",
   "pali": "dhammesu dhammānupassī viharati chasu … āyatanesu",
   "th": "ธัมมานุปัสสนาในอายตนะ 6",
   "term": "āyatana"
  },
  {
   "id": "s033",
   "segment_id": "dn22:21.2",
   "sutta_id": "dn22",
   "pali": "Ayameva ariyo aṭṭhaṅgiko maggo …",
   "th": "มรรค 8 (ในมหาสติปัฏฐาน)",
   "term": "aṭṭhaṅgika magga"
  },
  {
   "id": "s034",
   "segment_id": "dn2:42.1",
   "sutta_id": "dn2",
   "pali": "pātimokkhasaṁvarasaṁvuto viharati … samādāya sikkhati sikkhāpadesu",
   "th": "ปาติโมกขสังวร (ขั้นแรกของมรรค)",
   "term": "pātimokkha"
  },
  {
   "id": "s035",
   "segment_id": "vb4:1.1",
   "sutta_id": "vb4",
   "pali": "Cattāri ariyasaccāni—",
   "th": "อริยสัจ 4 (อภิธรรม สัจจวิภังค์)",
   "term": "ariyasacca"
  },
  {
   "id": "s036",
   "segment_id": "pli-tv-kd1:6.19.1",
   "sutta_id": "pli-tv-kd1",
   "pali": "Idaṁ kho pana, bhikkhave, dukkhaṁ ariyasaccaṁ",
   "th": "อริยสัจ 4 (วินัย มหาวรรค ปฐมเทศนา)",
   "term": "ariyasacca"
  },
  {
   "id": "s037",
   "segment_id": "dn33:1.7.6",
   "sutta_id": "dn33",
   "pali": "sabbeheva saṅgāyitabbaṁ na vivaditabbaṁ",
   "th": "สังคายนาร่วมไม่วิวาท (จุดประสงค์สังคีติ)",
   "term": "mātikā"
  },
  {
   "id": "s038",
   "segment_id": "dn34:1.2.1",
   "sutta_id": "dn34",
   "pali": "dhammo nipphāna-patthiyā …",
   "th": "ธรรมเพื่อนิพพาน (จุดประสงค์ทสุตตร)",
   "term": "mātikā"
  },
  {
   "id": "s039",
   "segment_id": "mn62:8.2",
   "sutta_id": "mn62",
   "pali": "pathavī … ayaṁ pathavīdhātu",
   "th": "ปฐวีธาตุ (กาย 31 ส่วน)",
   "term": "dhātu"
  },
  {
   "id": "s040",
   "segment_id": "mn9:11.5",
   "sutta_id": "mn9",
   "pali": "… samudayo … nirodho … ariyo aṭṭhaṅgiko maggo",
   "th": "กรอบ 5 ชั้นของสัมมาทิฏฐิ",
   "term": "sammādiṭṭhi"
  },
  {
   "id": "s041",
   "segment_id": "mn9:14.2",
   "sutta_id": "mn9",
   "pali": "sammādiṭṭhi … ariyasaccaṁ",
   "th": "สัมมาทิฏฐิ = ญาณในอริยสัจ",
   "term": "sammādiṭṭhi"
  }
